        "liquid_ntpnNr": {
          "type": "liquid",
          "settings": {
            "liquid": "<style>\n  .frezze-proof,\n  .frezze-proof * {\n    box-sizing: border-box;\n  }\n\n  .frezze-proof {\n    --green: #223a2d;\n    --soft-green: #9aaea0;\n    --text: #252525;\n\n    width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #ffffff;\n\n    font-family: \"Avenir Next\", Avenir, Helvetica, Arial, sans-serif;\n    color: var(--text);\n  }\n\n  .frezze-proof .fz-inner {\n    width: 100%;\n    margin: 0;\n    padding: 0 13px 8px;\n  }\n\n  /* =========================\n     AVIS\n  ========================= */\n\n  .frezze-proof .fz-rating {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 7px;\n\n    margin: 0 0 10px;\n    padding: 0;\n\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .frezze-proof .fz-stars {\n    color: var(--green);\n    font-size: 15px;\n    line-height: 1;\n    letter-spacing: 1px;\n  }\n\n  .frezze-proof .fz-rating-text {\n    color: #242432;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 500;\n  }\n\n  .frezze-proof .fz-rating-text strong {\n    font-weight: 800;\n  }\n\n  /* =========================\n     BANDEAU CLIENTS\n  ========================= */\n\n  .frezze-proof .fz-social {\n    width: 100%;\n\n    display: flex;\n    align-items: center;\n\n    gap: 10px;\n    padding: 10px 13px;\n\n    margin: 0 0 18px;\n\n    background: var(--green);\n    border-radius: 15px;\n  }\n\n  .frezze-proof .fz-avatars {\n    position: relative;\n\n    width: 64px;\n    min-width: 64px;\n    height: 34px;\n  }\n\n  .frezze-proof .fz-avatar {\n    position: absolute;\n    top: 0;\n\n    width: 34px;\n    height: 34px;\n\n    object-fit: cover;\n    border-radius: 50%;\n\n    border: 2px solid var(--green);\n    background: #ddd;\n  }\n\n  .frezze-proof .a1 {\n    left: 0;\n    z-index: 3;\n  }\n\n  .frezze-proof .a2 {\n    left: 15px;\n    z-index: 2;\n  }\n\n  .frezze-proof .a3 {\n    left: 30px;\n    z-index: 1;\n  }\n\n  .frezze-proof .fz-social-text {\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 12.4px;\n    line-height: 1.28;\n\n    font-weight: 400;\n  }\n\n  .frezze-proof .fz-social-text strong {\n    font-weight: 800;\n  }\n\n  /* =========================\n     TITRE\n  ========================= */\n\n  .frezze-proof .fz-title {\n    margin: 0 0 19px;\n\n    max-width: 335px;\n\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 29px;\n    line-height: 1;\n\n    letter-spacing: -0.7px;\n\n    font-weight: 700;\n    color: var(--green);\n  }\n\n  .frezze-proof .fz-title em {\n    color: var(--soft-green);\n    font-style: italic;\n    font-weight: 700;\n  }\n\n  /* =========================\n     NOUVEAUX ARGUMENTS\n  ========================= */\n\n  .frezze-proof .fz-list {\n    display: flex;\n    flex-direction: column;\n    gap: 17px;\n\n    margin: 0;\n    padding: 0;\n  }\n\n  .frezze-proof .fz-item {\n    display: flex;\n    align-items: center;\n\n    gap: 12px;\n\n    margin: 0;\n    padding: 0;\n  }\n\n  /* Check rond contour comme ta référence */\n  .frezze-proof .fz-check-outline {\n    width: 24px;\n    height: 24px;\n\n    min-width: 24px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border: 2px solid #223a2d;\n    border-radius: 50%;\n\n    background: transparent;\n  }\n\n  .frezze-proof .fz-check-outline svg {\n    width: 12px;\n    height: 12px;\n\n    display: block;\n\n    stroke: #223a2d;\n    stroke-width: 3;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n\n    fill: none;\n  }\n\n  .frezze-proof .fz-copy {\n    margin: 0;\n\n    color: #292929;\n\n    font-size: 14px;\n    line-height: 1.2;\n\n    font-weight: 500;\n\n    letter-spacing: -0.1px;\n  }\n\n  /* =========================\n     PETITS MOBILES\n  ========================= */\n\n  @media screen and (max-width: 390px) {\n\n    .frezze-proof .fz-inner {\n      padding-left: 11px;\n      padding-right: 11px;\n    }\n\n    .frezze-proof .fz-title {\n      font-size: 27px;\n      max-width: 310px;\n      margin-bottom: 17px;\n    }\n\n    .frezze-proof .fz-rating-text {\n      font-size: 12.4px;\n    }\n\n    .frezze-proof .fz-stars {\n      font-size: 14px;\n    }\n\n    .frezze-proof .fz-social {\n      padding: 9px 11px;\n    }\n\n    .frezze-proof .fz-social-text {\n      font-size: 11.8px;\n    }\n\n    .frezze-proof .fz-list {\n      gap: 15px;\n    }\n\n    .frezze-proof .fz-copy {\n      font-size: 13.5px;\n    }\n\n    .frezze-proof .fz-check-outline {\n      width: 23px;\n      height: 23px;\n      min-width: 23px;\n    }\n\n    .frezze-proof .fz-check-outline svg {\n      width: 11px;\n      height: 11px;\n    }\n  }\n</style>\n\n\n<div class=\"frezze-proof\">\n  <div class=\"fz-inner\">\n\n    <!-- AVIS -->\n    <div class=\"fz-rating\">\n      <div class=\"fz-stars\">★★★★★</div>\n\n      <div class=\"fz-rating-text\">\n        <strong>Noté 4,8</strong> · 2847 avis vérifiés\n      </div>\n    </div>\n\n\n    <!-- PREUVE SOCIALE -->\n    <div class=\"fz-social\">\n\n      <div class=\"fz-avatars\">\n\n        <img\n          class=\"fz-avatar a1\"\n          src=\"https://cdn.shopify.com/s/files/1/1086/1310/8043/files/Capture_d_ecran_2026-08-23_a_11.43.30.png?v=1790014631\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n        <img\n          class=\"fz-avatar a2\"\n          src=\"https://cdn.shopify.com/s/files/1/1086/1310/8043/files/random-person_2.jpg?v=1790014634\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n        <img\n          class=\"fz-avatar a3\"\n          src=\"https://cdn.shopify.com/s/files/1/1086/1310/8043/files/random-person.jpg?v=1790014637\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n      <p class=\"fz-social-text\">\n        <strong>Nathalie, Vincent, Céline</strong> et\n        <strong>+10 000 personnes</strong> ont déjà arrêté de fumer avec\n        <strong>FREZZE</strong>\n      </p>\n\n    </div>\n\n\n    <!-- TITRE -->\n    <h2 class=\"fz-title\">\n      Gardez le geste, <em>sans la dépendance.</em>\n    </h2>\n\n\n    <!-- NOUVEAUX ARGUMENTS -->\n    <div class=\"fz-list\">\n\n      <!-- 1 -->\n      <div class=\"fz-item\">\n\n        <div class=\"fz-check-outline\">\n          <svg viewBox=\"0 0 24 24\">\n            <polyline points=\"6 12.5 10 16.5 18 8.5\"></polyline>\n          </svg>\n        </div>\n\n        <p class=\"fz-copy\">\n          Sans produits chimiques\n        </p>\n\n      </div>\n\n\n      <!-- 2 -->\n      <div class=\"fz-item\">\n\n        <div class=\"fz-check-outline\">\n          <svg viewBox=\"0 0 24 24\">\n            <polyline points=\"6 12.5 10 16.5 18 8.5\"></polyline>\n          </svg>\n        </div>\n\n        <p class=\"fz-copy\">\n          12× plus efficace que les gommes\n        </p>\n\n      </div>\n\n\n      <!-- 3 -->\n      <div class=\"fz-item\">\n\n        <div class=\"fz-check-outline\">\n          <svg viewBox=\"0 0 24 24\">\n            <polyline points=\"6 12.5 10 16.5 18 8.5\"></polyline>\n          </svg>\n        </div>\n\n        <p class=\"fz-copy\">\n          Stoppe les envies à la source\n        </p>\n\n      </div>\n\n\n      <!-- 4 -->\n      <div class=\"fz-item\">\n\n        <div class=\"fz-check-outline\">\n          <svg viewBox=\"0 0 24 24\">\n            <polyline points=\"6 12.5 10 16.5 18 8.5\"></polyline>\n          </svg>\n        </div>\n\n        <p class=\"fz-copy\">\n          Goût naturel et agréable\n        </p>\n\n      </div>\n\n    </div>\n\n  </div>\n</div>"
