n(() => {\n  const root = document.querySelector(\n    '#shopify-section-{{ section.id }} [data-inspir-bar]'\n  );\n\n  if (!root) return;\n\n  const h = root.querySelector('[data-h]');\n  const m = root.querySelector('[data-m]');\n  const s = root.querySelector('[data-s]');\n\n  const START_SECONDS =\n    (7 * 3600) +\n    (7 * 60) +\n    21;\n\n  const end =\n    Date.now() +\n    (START_SECONDS * 1000);\n\n  const pad = n =>\n    String(n).padStart(2, '0');\n\n\n  function render() {\n\n    const remaining = Math.max(\n      0,\n      Math.ceil(\n        (end - Date.now()) / 1000\n      )\n    );\n\n    h.textContent =\n      pad(\n        Math.floor(\n          remaining / 3600\n        )\n      );\n\n    m.textContent =\n      pad(\n        Math.floor(\n          (remaining % 3600) / 60\n        )\n      );\n\n    s.textContent =\n      pad(\n        remaining % 60\n      );\n\n\n    if (remaining === 0) {\n      clearInterval(timer);\n    }\n  }\n\n\n  render();\n\n  const timer =\n    setInterval(render, 1000);\n\n})();\n</script>",
