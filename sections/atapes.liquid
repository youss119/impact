{% style %}

#frezze-how-{{ section.id }} {
  background: {{ section.settings.background }};
  color: {{ section.settings.text_color }};
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
}

#frezze-how-{{ section.id }} .fh-wrap {
  width: min(
    calc(100% - {{ section.settings.side_padding_desktop | times: 2 }}px),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}


/* ==============================
   TITRE
   ============================== */

#frezze-how-{{ section.id }} .fh-heading {
  margin: 0 0 7px;

  font-size: {{ section.settings.title_size_desktop }}px;
  line-height: 1.08;
  font-weight: 750;
  letter-spacing: -0.025em;

  color: {{ section.settings.text_color }};
}

#frezze-how-{{ section.id }} .fh-intro {
  max-width: 620px;

  margin: 0 0 {{ section.settings.heading_gap }}px;

  font-size: {{ section.settings.intro_size_desktop }}px;
  line-height: 1.45;

  color: {{ section.settings.muted_color }};
}


/* ==============================
   GRILLE
   ============================== */

#frezze-how-{{ section.id }} .fh-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  column-gap: {{ section.settings.column_gap_desktop }}px;
  row-gap: {{ section.settings.row_gap_desktop }}px;
}


/* ==============================
   ÉTAPE
   ============================== */

#frezze-how-{{ section.id }} .fh-step {
  min-width: 0;
}

#frezze-how-{{ section.id }} .fh-image-wrap {
  width: {{ section.settings.image_size_desktop }}px;
  height: {{ section.settings.image_size_desktop }}px;

  margin-bottom: 10px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

#frezze-how-{{ section.id }} .fh-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
}

#frezze-how-{{ section.id }} .fh-step-title {
  margin: 0 0 5px;

  font-size: {{ section.settings.step_title_size_desktop }}px;
  line-height: 1.1;
  font-weight: 750;

  color: {{ section.settings.text_color }};
}

#frezze-how-{{ section.id }} .fh-step-text {
  margin: 0;

  max-width: 220px;

  font-size: {{ section.settings.step_text_size_desktop }}px;
  line-height: 1.42;

  color: {{ section.settings.muted_color }};
}


/* ==============================
   TITRE DU BLOC SUIVANT
   ============================== */

#frezze-how-{{ section.id }} .fh-bottom-title {
  margin:
    {{ section.settings.bottom_title_margin }}px
    0
    0;

  text-align: center;

  font-size: {{ section.settings.bottom_title_size }}px;
  line-height: 1.08;
  font-weight: 750;

  color: {{ section.settings.text_color }};
}


/* ==============================
   MOBILE
   ============================== */

@media screen and (max-width: 749px) {

  #frezze-how-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #frezze-how-{{ section.id }} .fh-wrap {
    width: calc(
      100% - {{ section.settings.side_padding_mobile | times: 2 }}px
    );
  }

  #frezze-how-{{ section.id }} .fh-heading {
    font-size: {{ section.settings.title_size_mobile }}px;
  }

  #frezze-how-{{ section.id }} .fh-intro {
    margin-bottom: {{ section.settings.heading_gap_mobile }}px;

    font-size: {{ section.settings.intro_size_mobile }}px;
    line-height: 1.42;
  }

  /* EXACTEMENT 2 × 2 */

  #frezze-how-{{ section.id }} .fh-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    column-gap: {{ section.settings.column_gap_mobile }}px;
    row-gap: {{ section.settings.row_gap_mobile }}px;
  }

  #frezze-how-{{ section.id }} .fh-image-wrap {
    width: {{ section.settings.image_size_mobile }}px;
    height: {{ section.settings.image_size_mobile }}px;

    margin-bottom: 7px;
  }

  #frezze-how-{{ section.id }} .fh-step-title {
    margin-bottom: 4px;

    font-size: {{ section.settings.step_title_size_mobile }}px;
  }

  #frezze-how-{{ section.id }} .fh-step-text {
    max-width: 155px;

    font-size: {{ section.settings.step_text_size_mobile }}px;
    line-height: 1.36;
  }

  #frezze-how-{{ section.id }} .fh-bottom-title {
    margin-top: {{ section.settings.bottom_title_margin_mobile }}px;

    font-size: {{ section.settings.bottom_title_size_mobile }}px;
  }

}

{% endstyle %}


<section id="frezze-how-{{ section.id }}">

  <div class="fh-wrap">


    {% if section.settings.heading != blank %}

      <h2 class="fh-heading">
        {{ section.settings.heading }}
      </h2>

    {% endif %}


    {% if section.settings.intro != blank %}

      <p class="fh-intro">
        {{ section.settings.intro }}
      </p>

    {% endif %}



    <div class="fh-grid">

      {% for block in section.blocks %}

        <div
          class="fh-step"
          {{ block.shopify_attributes }}
        >


          <div class="fh-image-wrap">

            {% if block.settings.custom_image != blank %}

              <img
                class="fh-image"
                src="{{ block.settings.custom_image | image_url: width: 600 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >

            {% elsif block.settings.image_url != blank %}

              <img
                class="fh-image"
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >

            {% endif %}

          </div>


          {% if block.settings.title != blank %}

            <h3 class="fh-step-title">
              {{ block.settings.title }}
            </h3>

          {% endif %}


          {% if block.settings.text != blank %}

            <p class="fh-step-text">
              {{ block.settings.text }}
            </p>

          {% endif %}


        </div>

      {% endfor %}

    </div>



    {% if section.settings.bottom_title != blank %}

      <h2 class="fh-bottom-title">
        {{ section.settings.bottom_title }}
      </h2>

    {% endif %}


  </div>

</section>


