{% style %}

/* =========================================================
   VU SUR — FREZZE
   ========================================================= */

#vu-sur-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

#vu-sur-{{ section.id }} .vu-sur__container {
  width: min(
    calc(100% - ({{ section.settings.side_padding_desktop }}px * 2)),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}

/* ---------- TITRE ---------- */

#vu-sur-{{ section.id }} .vu-sur__title {
  margin: 0 0 {{ section.settings.title_margin_bottom }}px;
  padding: 0;

  text-align: center;

  color: {{ section.settings.title_color }};

  font-size: {{ section.settings.title_size_desktop }}px;
  line-height: 1.05;

  font-weight: {{ section.settings.title_weight }};
  letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 10.0 }}px;
}

/* ---------- GRILLE ---------- */

#vu-sur-{{ section.id }} .vu-sur__grid {
  display: grid;

  grid-template-columns:
    repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));

  gap: {{ section.settings.gap_desktop }}px;
}

/* ---------- CARTE ---------- */

#vu-sur-{{ section.id }} .vu-sur__card {
  position: relative;

  display: flex;
  justify-content: center;
  align-items: center;

  width: 100%;

  aspect-ratio: {{ section.settings.ratio_desktop }};

  padding: {{ section.settings.card_padding_desktop }}px;

  box-sizing: border-box;

  background: {{ section.settings.card_bg }};

  border-radius: {{ section.settings.card_radius }}px;

  overflow: hidden;
}

/* ---------- LOGOS ---------- */

#vu-sur-{{ section.id }} .vu-sur__logo {
  display: block;

  width: auto;
  height: auto;

  object-fit: contain;

  max-height: 70%;
}

/* Vogue */

#vu-sur-{{ section.id }} .logo-vogue {
  max-width: {{ section.settings.vogue_size_desktop }}%;
}

/* Voici */

#vu-sur-{{ section.id }} .logo-voici {
  max-width: {{ section.settings.voici_size_desktop }}%;
}

/* Marie Claire */

#vu-sur-{{ section.id }} .logo-marie {
  max-width: {{ section.settings.marie_size_desktop }}%;
}

/* Cosmopolitan */

#vu-sur-{{ section.id }} .logo-cosmo {
  max-width: {{ section.settings.cosmo_size_desktop }}%;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  #vu-sur-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #vu-sur-{{ section.id }} .vu-sur__container {
    width: calc(
      100% - ({{ section.settings.side_padding_mobile }}px * 2)
    );
  }

  #vu-sur-{{ section.id }} .vu-sur__title {
    font-size: {{ section.settings.title_size_mobile }}px;

    margin-bottom:
      {{ section.settings.title_margin_bottom_mobile }}px;
  }

  #vu-sur-{{ section.id }} .vu-sur__grid {
    grid-template-columns:
      repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));

    gap: {{ section.settings.gap_mobile }}px;
  }

  #vu-sur-{{ section.id }} .vu-sur__card {
    aspect-ratio: {{ section.settings.ratio_mobile }};

    padding: {{ section.settings.card_padding_mobile }}px;
  }

  #vu-sur-{{ section.id }} .logo-vogue {
    max-width: {{ section.settings.vogue_size_mobile }}%;
  }

  #vu-sur-{{ section.id }} .logo-voici {
    max-width: {{ section.settings.voici_size_mobile }}%;
  }

  #vu-sur-{{ section.id }} .logo-marie {
    max-width: {{ section.settings.marie_size_mobile }}%;
  }

  #vu-sur-{{ section.id }} .logo-cosmo {
    max-width: {{ section.settings.cosmo_size_mobile }}%;
  }

}

{% endstyle %}


<section id="vu-sur-{{ section.id }}">

  <div class="vu-sur__container">

    {% if section.settings.title != blank %}

      <h2 class="vu-sur__title">
        {{ section.settings.title }}
      </h2>

    {% endif %}


    <div class="vu-sur__grid">

      <!-- VOGUE -->

      <div class="vu-sur__card">

        <img
          class="vu-sur__logo logo-vogue"

          src="https://averaparis.com/cdn/shop/files/f3bd8e7f-8ae4-49fa-b9eb-defd662e1cca.webp?v=1787151149&width=800"

          alt="Vogue"

          loading="lazy"
          decoding="async"

          width="800"
          height="500"
        >

      </div>


      <!-- VOICI -->

      <div class="vu-sur__card">

        <img
          class="vu-sur__logo logo-voici"

          src="https://averaparis.com/cdn/shop/files/cfa4a636-7de1-42eb-8553-4c72eecae22f.webp?v=1787151149&width=800"

          alt="Voici"

          loading="lazy"
          decoding="async"

          width="800"
          height="500"
        >

      </div>


      <!-- MARIE CLAIRE -->

      <div class="vu-sur__card">

        <img
          class="vu-sur__logo logo-marie"

          src="https://averaparis.com/cdn/shop/files/e525f5e1-2ac0-4ad3-b8ce-f2a580da9271.png?v=1787151501&width=800"

          alt="Marie Claire"

          loading="lazy"
          decoding="async"

          width="800"
          height="500"
        >

      </div>


      <!-- COSMOPOLITAN -->

      <div class="vu-sur__card">

        <img
          class="vu-sur__logo logo-cosmo"

          src="https://averaparis.com/cdn/shop/files/Cosmopolitan-Emblem.png?v=1787151478&width=1000"

          alt="Cosmopolitan"

          loading="lazy"
          decoding="async"

          width="1000"
          height="500"
        >

      </div>

    </div>

  </div>

</section>


