{% style %}

/* =========================================================
   FREZZE — SECTION "VU SUR"
   ========================================================= */

#press-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
}

#press-{{ section.id }} .press-wrap {
  width: min(
    calc(100% - {{ section.settings.side_padding_desktop | times: 2 }}px),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}


/* =========================================================
   TITRE
   ========================================================= */

#press-{{ section.id }} .press-title {
  margin: 0 0 {{ section.settings.title_gap_desktop }}px;
  padding: 0;

  text-align: center;

  font-size: {{ section.settings.title_size_desktop }}px;
  line-height: 1;

  font-weight: {{ section.settings.title_weight }};
  letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 10.0 }}px;

  color: {{ section.settings.title_color }};
}


/* =========================================================
   GRILLE
   ========================================================= */

#press-{{ section.id }} .press-grid {
  display: grid;

  grid-template-columns:
    repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));

  gap: {{ section.settings.gap_desktop }}px;
}


/* =========================================================
   CARTES
   ========================================================= */

#press-{{ section.id }} .press-card {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;

  aspect-ratio: {{ section.settings.card_ratio_desktop }};

  box-sizing: border-box;

  overflow: hidden;

  padding: {{ section.settings.card_padding_desktop }}px;

  background: {{ section.settings.card_bg }};

  border-radius: {{ section.settings.card_radius }}px;

  {% if section.settings.border_enabled %}
    border: 1px solid {{ section.settings.border_color }};
  {% endif %}
}


/* =========================================================
   IMAGES
   ========================================================= */

#press-{{ section.id }} .press-logo {
  display: block;

  width: auto;
  height: auto;

  object-fit: contain;

  transform-origin: center;
}


/* VOGUE */

#press-{{ section.id }} .logo-vogue {
  max-width: {{ section.settings.vogue_width_desktop }}%;
  max-height: {{ section.settings.vogue_height_desktop }}%;

  transform:
    scale({{ section.settings.vogue_zoom_desktop | divided_by: 100.0 }});
}


/* VOICI */

#press-{{ section.id }} .logo-voici {
  max-width: {{ section.settings.voici_width_desktop }}%;
  max-height: {{ section.settings.voici_height_desktop }}%;

  transform:
    scale({{ section.settings.voici_zoom_desktop | divided_by: 100.0 }});
}


/* TF1 */

#press-{{ section.id }} .logo-tf1 {
  max-width: {{ section.settings.tf1_width_desktop }}%;
  max-height: {{ section.settings.tf1_height_desktop }}%;

  transform:
    scale({{ section.settings.tf1_zoom_desktop | divided_by: 100.0 }});
}


/* COSMOPOLITAN */

#press-{{ section.id }} .logo-cosmo {
  max-width: {{ section.settings.cosmo_width_desktop }}%;
  max-height: {{ section.settings.cosmo_height_desktop }}%;

  transform:
    scale({{ section.settings.cosmo_zoom_desktop | divided_by: 100.0 }});
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  #press-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #press-{{ section.id }} .press-wrap {
    width: calc(
      100% - {{ section.settings.side_padding_mobile | times: 2 }}px
    );
  }

  #press-{{ section.id }} .press-title {
    font-size: {{ section.settings.title_size_mobile }}px;

    margin-bottom:
      {{ section.settings.title_gap_mobile }}px;
  }

  #press-{{ section.id }} .press-grid {
    grid-template-columns:
      repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));

    gap: {{ section.settings.gap_mobile }}px;
  }

  #press-{{ section.id }} .press-card {
    aspect-ratio: {{ section.settings.card_ratio_mobile }};

    padding: {{ section.settings.card_padding_mobile }}px;
  }


  /* VOGUE MOBILE */

  #press-{{ section.id }} .logo-vogue {
    max-width: {{ section.settings.vogue_width_mobile }}%;
    max-height: {{ section.settings.vogue_height_mobile }}%;

    transform:
      scale({{ section.settings.vogue_zoom_mobile | divided_by: 100.0 }});
  }


  /* VOICI MOBILE */

  #press-{{ section.id }} .logo-voici {
    max-width: {{ section.settings.voici_width_mobile }}%;
    max-height: {{ section.settings.voici_height_mobile }}%;

    transform:
      scale({{ section.settings.voici_zoom_mobile | divided_by: 100.0 }});
  }


  /* TF1 MOBILE */

  #press-{{ section.id }} .logo-tf1 {
    max-width: {{ section.settings.tf1_width_mobile }}%;
    max-height: {{ section.settings.tf1_height_mobile }}%;

    transform:
      scale({{ section.settings.tf1_zoom_mobile | divided_by: 100.0 }});
  }


  /* COSMO MOBILE */

  #press-{{ section.id }} .logo-cosmo {
    max-width: {{ section.settings.cosmo_width_mobile }}%;
    max-height: {{ section.settings.cosmo_height_mobile }}%;

    transform:
      scale({{ section.settings.cosmo_zoom_mobile | divided_by: 100.0 }});
  }

}

{% endstyle %}


<section id="press-{{ section.id }}">

  <div class="press-wrap">

    {% if section.settings.title != blank %}

      <h2 class="press-title">
        {{ section.settings.title }}
      </h2>

    {% endif %}


    <div class="press-grid">


      <!-- =====================================================
           VOGUE
           ===================================================== -->

      <div class="press-card">

        <img
          class="press-logo logo-vogue"

          src="https://averaparis.com/cdn/shop/files/f3bd8e7f-8ae4-49fa-b9eb-defd662e1cca.webp?v=1787151149&width=1000"

          alt="Vogue"

          loading="lazy"
          decoding="async"

          width="1000"
          height="600"
        >

      </div>



      <!-- =====================================================
           VOICI
           ===================================================== -->

      <div class="press-card">

        <img
          class="press-logo logo-voici"

          src="https://averaparis.com/cdn/shop/files/cfa4a636-7de1-42eb-8553-4c72eecae22f.webp?v=1787151149&width=1000"

          alt="Voici"

          loading="lazy"
          decoding="async"

          width="1000"
          height="600"
        >

      </div>



      <!-- =====================================================
           TF1
           ===================================================== -->

      <div class="press-card">

        <img
          class="press-logo logo-tf1"

          src="https://cdn.prod.website-files.com/66623b8ed9fb98b455123844/6669c1920232836a2ee3dfd5_tf1-logo-black-and-white.png"

          alt="TF1"

          loading="lazy"
          decoding="async"

          width="1200"
          height="600"
        >

      </div>



      <!-- =====================================================
           COSMOPOLITAN
           ===================================================== -->

      <div class="press-card">

        <img
          class="press-logo logo-cosmo"

          src="https://averaparis.com/cdn/shop/files/Cosmopolitan-Emblem.png?v=1787151478&width=1600"

          alt="Cosmopolitan"

          loading="lazy"
          decoding="async"

          width="1600"
          height="800"
        >

      </div>


    </div>

  </div>

</section>



