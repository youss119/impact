{% liquid
  assign left_points = section.settings.left_points | newline_to_br | split: '<br />'
  assign right_points = section.settings.right_points | newline_to_br | split: '<br />'
%}

{% style %}

#frezze-compare-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
}

#frezze-compare-{{ section.id }} .fc-wrap {
  width: min(
    calc(100% - {{ section.settings.side_padding_desktop | times: 2 }}px),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}


/* =========================
   IMAGE
   ========================= */

#frezze-compare-{{ section.id }} .fc-media {
  display: flex;
  justify-content: center;
  width: 100%;
}

#frezze-compare-{{ section.id }} .fc-image-window {
  position: relative;

  width: 100%;
  max-width: {{ section.settings.image_max_width_desktop }}px;

  height: {{ section.settings.image_height_desktop }}px;

  overflow: hidden;

  background: #ffffff;

  border-radius: {{ section.settings.image_radius }}px;
}

#frezze-compare-{{ section.id }} .fc-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
  object-position: center;

  transform:
    translate(
      {{ section.settings.image_offset_x_desktop }}px,
      {{ section.settings.image_offset_y_desktop }}px
    )
    scale({{ section.settings.image_scale_desktop | divided_by: 100.0 }});

  transform-origin: center;
}

#frezze-compare-{{ section.id }} .fc-placeholder {
  width: 100%;
  height: 100%;
  background: #f4f4f4;
}


/* =========================
   CARTES
   ========================= */

#frezze-compare-{{ section.id }} .fc-cards {
  position: relative;
  z-index: 2;

  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: {{ section.settings.cards_gap_desktop }}px;

  margin-top: -{{ section.settings.cards_overlap_desktop }}px;
}

#frezze-compare-{{ section.id }} .fc-card {
  box-sizing: border-box;

  padding: {{ section.settings.card_padding_desktop }}px;

  border-radius: {{ section.settings.card_radius }}px;

  {% if section.settings.show_border %}
    border: 1px solid {{ section.settings.border_color }};
  {% endif %}

  {% if section.settings.show_shadow %}
    box-shadow: 0 8px 24px rgba(0,0,0,.06);
  {% endif %}
}

#frezze-compare-{{ section.id }} .fc-card--bad {
  background: {{ section.settings.left_card_bg }};
}

#frezze-compare-{{ section.id }} .fc-card--good {
  background: {{ section.settings.right_card_bg }};
}


/* TITRES */

#frezze-compare-{{ section.id }} .fc-title {
  margin: 0 0 {{ section.settings.title_bottom_spacing }}px;

  color: {{ section.settings.title_color }};

  font-size: {{ section.settings.title_size_desktop }}px;
  line-height: 1.12;

  font-weight: 700;
}


/* LISTES */

#frezze-compare-{{ section.id }} .fc-list {
  list-style: none;

  padding: 0;
  margin: 0;
}

#frezze-compare-{{ section.id }} .fc-list li {
  display: flex;
  align-items: flex-start;

  gap: 9px;

  color: {{ section.settings.text_color }};

  font-size: {{ section.settings.text_size_desktop }}px;
  line-height: 1.35;
}

#frezze-compare-{{ section.id }} .fc-list li + li {
  margin-top: {{ section.settings.bullet_spacing }}px;
}


/* BULLETS */

#frezze-compare-{{ section.id }} .fc-bullet {
  flex: 0 0 auto;

  width: 18px;

  margin-top: 1px;

  font-weight: 800;
  line-height: 1.2;
}

#frezze-compare-{{ section.id }} .fc-card--bad .fc-bullet {
  color: {{ section.settings.left_bullet_color }};
}

#frezze-compare-{{ section.id }} .fc-card--good .fc-bullet {
  color: {{ section.settings.right_bullet_color }};
}


/* =========================
   MOBILE
   ========================= */

@media screen and (max-width: 749px) {

  #frezze-compare-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-wrap {
    width: calc(
      100% - {{ section.settings.side_padding_mobile | times: 2 }}px
    );
  }

  #frezze-compare-{{ section.id }} .fc-image-window {
    max-width: 100%;

    height: {{ section.settings.image_height_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-image {
    transform:
      translate(
        {{ section.settings.image_offset_x_mobile }}px,
        {{ section.settings.image_offset_y_mobile }}px
      )
      scale({{ section.settings.image_scale_mobile | divided_by: 100.0 }});
  }

  #frezze-compare-{{ section.id }} .fc-cards {
    grid-template-columns: 1fr;

    gap: {{ section.settings.cards_gap_mobile }}px;

    margin-top: -{{ section.settings.cards_overlap_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-card {
    padding: {{ section.settings.card_padding_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-title {
    font-size: {{ section.settings.title_size_mobile }}px;

    margin-bottom: {{ section.settings.title_bottom_spacing_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-list li {
    font-size: {{ section.settings.text_size_mobile }}px;

    gap: 8px;
  }

}

{% endstyle %}



<section id="frezze-compare-{{ section.id }}">

  <div class="fc-wrap">


    <!-- IMAGE -->

    <div class="fc-media">

      <div class="fc-image-window">

        {% if section.settings.main_image != blank %}

          <img
            class="fc-image"
            src="{{ section.settings.main_image | image_url: width: 2000 }}"
            alt="{{ section.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.main_image.width }}"
            height="{{ section.settings.main_image.height }}"
          >

        {% else %}

          <div class="fc-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>

        {% endif %}

      </div>

    </div>



    <!-- CARTES -->

    <div class="fc-cards">


      <!-- TABAC -->

      <div class="fc-card fc-card--bad">

        {% if section.settings.left_title != blank %}

          <h3 class="fc-title">
            {{ section.settings.left_title }}
          </h3>

        {% endif %}


        <ul class="fc-list">

          {% for item in left_points %}

            {% assign clean_item = item | strip %}

            {% if clean_item != blank %}

              <li>

                <span class="fc-bullet">
                  {{ section.settings.left_bullet }}
                </span>

                <span>
                  {{ clean_item }}
                </span>

              </li>

            {% endif %}

          {% endfor %}

        </ul>

      </div>



      <!-- FREZZE -->

      <div class="fc-card fc-card--good">

        {% if section.settings.right_title != blank %}

          <h3 class="fc-title">
            {{ section.settings.right_title }}
          </h3>

        {% endif %}


        <ul class="fc-list">

          {% for item in right_points %}

            {% assign clean_item = item | strip %}

            {% if clean_item != blank %}

              <li>

                <span class="fc-bullet">
                  {{ section.settings.right_bullet }}
                </span>

                <span>
                  {{ clean_item }}
                </span>

              </li>

            {% endif %}

          {% endfor %}

        </ul>

      </div>


    </div>

  </div>

</section>



