{% liquid
  assign left_points = section.settings.left_points | newline_to_br | split: '<br />'
  assign right_points = section.settings.right_points | newline_to_br | split: '<br />'
%}

{% style %}

/* =========================================================
   FREZZE — COMPARAISON POUMONS
   ========================================================= */

#frezze-compare-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
}

#frezze-compare-{{ section.id }} .fc-wrap {
  width: min(
    calc(100% - {{ section.settings.side_padding_desktop | times: 2 }}px),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}


/* =========================================================
   IMAGE
   ========================================================= */

#frezze-compare-{{ section.id }} .fc-image-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

#frezze-compare-{{ section.id }} .fc-image-window {
  position: relative;

  width: 100%;
  max-width: {{ section.settings.image_max_width_desktop }}px;
  height: {{ section.settings.image_height_desktop }}px;

  overflow: hidden;

  background: #ffffff;

  border-radius: {{ section.settings.image_radius }}px;
}

#frezze-compare-{{ section.id }} .fc-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
  object-position: center;

  transform:
    translate(
      {{ section.settings.image_offset_x_desktop }}px,
      {{ section.settings.image_offset_y_desktop }}px
    )
    scale({{ section.settings.image_scale_desktop | divided_by: 100.0 }});

  transform-origin: center center;
}

#frezze-compare-{{ section.id }} .fc-placeholder {
  width: 100%;
  height: 100%;

  background: #f5f5f5;
}


/* =========================================================
   CARTES
   ========================================================= */

#frezze-compare-{{ section.id }} .fc-cards {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: {{ section.settings.cards_gap_desktop }}px;

  margin-top: {{ section.settings.cards_margin_top_desktop }}px;
}

#frezze-compare-{{ section.id }} .fc-card {
  min-width: 0;

  box-sizing: border-box;

  padding:
    {{ section.settings.card_padding_vertical_desktop }}px
    {{ section.settings.card_padding_horizontal_desktop }}px;

  border-radius: {{ section.settings.card_radius }}px;

  overflow: hidden;
}

#frezze-compare-{{ section.id }} .fc-card--left {
  background: {{ section.settings.left_card_bg }};
}

#frezze-compare-{{ section.id }} .fc-card--right {
  background: {{ section.settings.right_card_bg }};
}


/* =========================================================
   LISTES
   ========================================================= */

#frezze-compare-{{ section.id }} .fc-list {
  list-style: none;

  margin: 0;
  padding: 0;
}

#frezze-compare-{{ section.id }} .fc-list li {
  display: flex;

  align-items: flex-start;

  gap: {{ section.settings.icon_gap_desktop }}px;

  margin: 0;

  color: {{ section.settings.text_color }};

  font-size: {{ section.settings.text_size_desktop }}px;
  line-height: 1.25;

  font-weight: {{ section.settings.text_weight }};
}

#frezze-compare-{{ section.id }} .fc-list li + li {
  margin-top: {{ section.settings.bullet_spacing_desktop }}px;
}


/* =========================================================
   BULLETS
   ========================================================= */

#frezze-compare-{{ section.id }} .fc-icon {
  flex: 0 0 auto;

  display: inline-flex;

  width: {{ section.settings.icon_width_desktop }}px;

  align-items: center;
  justify-content: center;

  font-size: {{ section.settings.icon_size_desktop }}px;

  font-weight: 800;

  line-height: 1.15;
}

#frezze-compare-{{ section.id }} .fc-card--left .fc-icon {
  color: {{ section.settings.left_bullet_color }};
}

#frezze-compare-{{ section.id }} .fc-card--right .fc-icon {
  color: {{ section.settings.right_bullet_color }};
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  #frezze-compare-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-wrap {
    width: calc(
      100% - {{ section.settings.side_padding_mobile | times: 2 }}px
    );
  }


  /* IMAGE */

  #frezze-compare-{{ section.id }} .fc-image-window {
    max-width: 100%;

    height: {{ section.settings.image_height_mobile }}px;
  }

  #frezze-compare-{{ section.id }} .fc-image {
    transform:
      translate(
        {{ section.settings.image_offset_x_mobile }}px,
        {{ section.settings.image_offset_y_mobile }}px
      )
      scale({{ section.settings.image_scale_mobile | divided_by: 100.0 }});
  }


  /* LES 2 CARTES RESTENT CÔTE À CÔTE */

  #frezze-compare-{{ section.id }} .fc-cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: {{ section.settings.cards_gap_mobile }}px;

    margin-top: {{ section.settings.cards_margin_top_mobile }}px;
  }


  /* CARTES COMPACTES */

  #frezze-compare-{{ section.id }} .fc-card {
    padding:
      {{ section.settings.card_padding_vertical_mobile }}px
      {{ section.settings.card_padding_horizontal_mobile }}px;
  }


  /* TEXTE */

  #frezze-compare-{{ section.id }} .fc-list li {
    gap: {{ section.settings.icon_gap_mobile }}px;

    font-size: {{ section.settings.text_size_mobile }}px;

    line-height: 1.22;
  }

  #frezze-compare-{{ section.id }} .fc-list li + li {
    margin-top: {{ section.settings.bullet_spacing_mobile }}px;
  }


  /* ICONES */

  #frezze-compare-{{ section.id }} .fc-icon {
    width: {{ section.settings.icon_width_mobile }}px;

    font-size: {{ section.settings.icon_size_mobile }}px;
  }

}

{% endstyle %}



<section id="frezze-compare-{{ section.id }}">

  <div class="fc-wrap">


    <!-- IMAGE -->

    <div class="fc-image-wrap">

      <div class="fc-image-window">

        {% if section.settings.main_image != blank %}

          <img
            class="fc-image"
            src="{{ section.settings.main_image | image_url: width: 2000 }}"
            alt="{{ section.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.main_image.width }}"
            height="{{ section.settings.main_image.height }}"
          >

        {% else %}

          <div class="fc-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>

        {% endif %}

      </div>

    </div>



    <!-- CARTES -->

    <div class="fc-cards">


      <!-- GAUCHE : TABAC -->

      <div class="fc-card fc-card--left">

        <ul class="fc-list">

          {% for item in left_points %}

            {% assign clean_item = item | strip %}

            {% if clean_item != blank %}

              <li>

                <span class="fc-icon">
                  {{ section.settings.left_bullet }}
                </span>

                <span>
                  {{ clean_item }}
                </span>

              </li>

            {% endif %}

          {% endfor %}

        </ul>

      </div>



      <!-- DROITE : FREZZE -->

      <div class="fc-card fc-card--right">

        <ul class="fc-list">

          {% for item in right_points %}

            {% assign clean_item = item | strip %}

            {% if clean_item != blank %}

              <li>

                <span class="fc-icon">
                  {{ section.settings.right_bullet }}
                </span>

                <span>
                  {{ clean_item }}
                </span>

              </li>

            {% endif %}

          {% endfor %}

        </ul>

      </div>


    </div>

  </div>

</section>



