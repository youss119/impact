{% style %}

/* =========================================================
   FREZZE — AVIS CLIENTS
   ========================================================= */

#reviews-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

#reviews-{{ section.id }} .reviews-wrap {
  width: min(
    calc(100% - {{ section.settings.side_padding | times: 2 }}px),
    {{ section.settings.max_width }}px
  );
  margin: 0 auto;
}


/* =========================================================
   HEADER
   ========================================================= */

#reviews-{{ section.id }} .reviews-header {
  margin-bottom: {{ section.settings.header_gap }}px;
}

#reviews-{{ section.id }} .reviews-title {
  margin: 0 0 8px 0;

  font-size: {{ section.settings.title_size }}px;
  line-height: 1.12;

  font-weight: 700;

  color: {{ section.settings.text_color }};
}


/* =========================================================
   TRUSTPILOT
   ========================================================= */

#reviews-{{ section.id }} .trust-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px;
}

#reviews-{{ section.id }} .trust-brand {
  display: flex;
  align-items: center;

  gap: 5px;

  font-size: 14px;
  line-height: 1;

  font-weight: 700;

  color: {{ section.settings.text_color }};
}

#reviews-{{ section.id }} .trust-main-star {
  color: {{ section.settings.trust_color }};
  font-size: 19px;
}

#reviews-{{ section.id }} .trust-stars {
  display: flex;
  gap: 2px;
}

#reviews-{{ section.id }} .trust-star {
  width: 20px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: {{ section.settings.trust_color }};
  color: #ffffff;

  border-radius: 2px;

  font-size: 12px;
  line-height: 1;
}

#reviews-{{ section.id }} .trust-score {
  width: 100%;

  margin-top: 1px;

  color: {{ section.settings.muted_color }};

  font-size: 12px;
  line-height: 1.3;
}

#reviews-{{ section.id }} .trust-score strong {
  color: {{ section.settings.text_color }};
}


/* =========================================================
   CAROUSEL
   ========================================================= */

#reviews-{{ section.id }} .reviews-track {
  display: flex;

  gap: {{ section.settings.card_gap }}px;

  overflow-x: auto;
  overflow-y: hidden;

  scroll-snap-type: x mandatory;
  overscroll-behavior-x: contain;

  -webkit-overflow-scrolling: touch;

  padding-bottom: 3px;

  scrollbar-width: none;
}

#reviews-{{ section.id }} .reviews-track::-webkit-scrollbar {
  display: none;
}


/* =========================================================
   CARD
   ========================================================= */

#reviews-{{ section.id }} .review-card {
  flex: 0 0 calc(
    (100% - ({{ section.settings.desktop_cards | minus: 1 }} * {{ section.settings.card_gap }}px))
    / {{ section.settings.desktop_cards }}
  );

  min-width: 0;

  scroll-snap-align: start;

  background: {{ section.settings.card_bg }};

  border:
    {{ section.settings.border_width }}px
    solid
    {{ section.settings.border_color }};

  border-radius: {{ section.settings.card_radius }}px;

  overflow: hidden;
}


/* =========================================================
   IMAGE
   ========================================================= */

#reviews-{{ section.id }} .review-image-wrap {
  position: relative;

  width: 100%;
  height: {{ section.settings.image_height_desktop }}px;

  overflow: hidden;

  background: #f5f5f5;
}

#reviews-{{ section.id }} .review-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;
}

#reviews-{{ section.id }} .review-image-placeholder {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  color: #999;
  background: #f4f4f4;

  font-size: 12px;
}


/* =========================================================
   CONTENT
   ========================================================= */

#reviews-{{ section.id }} .review-content {
  padding: {{ section.settings.card_padding }}px;
}

#reviews-{{ section.id }} .review-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 7px;

  margin-bottom: 8px;
}


/* =========================================================
   STARS
   ========================================================= */

#reviews-{{ section.id }} .review-stars {
  display: flex;
  gap: 1px;

  color: {{ section.settings.trust_color }};

  font-size: 14px;
  line-height: 1;
}

#reviews-{{ section.id }} .verified {
  display: inline-flex;

  align-items: center;

  gap: 3px;

  color: {{ section.settings.muted_color }};

  font-size: 10px;
  line-height: 1;

  white-space: nowrap;
}

#reviews-{{ section.id }} .verified-check {
  color: {{ section.settings.trust_color }};

  font-weight: 800;
}


/* =========================================================
   TEXT
   ========================================================= */

#reviews-{{ section.id }} .review-text {
  margin: 0;

  color: {{ section.settings.text_color }};

  font-size: {{ section.settings.review_size }}px;
  line-height: 1.42;

  font-weight: 400;
}

#reviews-{{ section.id }} .review-bottom {
  margin-top: 12px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 8px;
}

#reviews-{{ section.id }} .review-name {
  color: {{ section.settings.text_color }};

  font-size: 12px;
  line-height: 1.2;

  font-weight: 700;
}

#reviews-{{ section.id }} .review-date {
  color: {{ section.settings.muted_color }};

  font-size: 10px;
  line-height: 1.2;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  #reviews-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #reviews-{{ section.id }} .reviews-wrap {
    width: calc(
      100% - {{ section.settings.side_padding_mobile | times: 2 }}px
    );
  }

  #reviews-{{ section.id }} .reviews-title {
    font-size: {{ section.settings.title_size_mobile }}px;
  }

  #reviews-{{ section.id }} .reviews-header {
    margin-bottom: {{ section.settings.header_gap_mobile }}px;
  }

  #reviews-{{ section.id }} .review-card {
    flex: 0 0 {{ section.settings.mobile_card_width }}%;
  }

  #reviews-{{ section.id }} .review-image-wrap {
    height: {{ section.settings.image_height_mobile }}px;
  }

  #reviews-{{ section.id }} .review-content {
    padding: {{ section.settings.card_padding_mobile }}px;
  }

  #reviews-{{ section.id }} .review-text {
    font-size: {{ section.settings.review_size_mobile }}px;
  }

}

{% endstyle %}



<section id="reviews-{{ section.id }}">

  <div class="reviews-wrap">


    <!-- HEADER -->

    <div class="reviews-header">

      {% if section.settings.title != blank %}

        <h2 class="reviews-title">
          {{ section.settings.title }}
        </h2>

      {% endif %}


      {% if section.settings.show_trustpilot %}

        <div class="trust-row">

          <div class="trust-brand">

            <span class="trust-main-star">★</span>

            <span>
              {{ section.settings.trust_name }}
            </span>

          </div>


          <div class="trust-stars">

            {% for i in (1..5) %}

              <span class="trust-star">
                ★
              </span>

            {% endfor %}

          </div>


          <div class="trust-score">

            <strong>
              {{ section.settings.score }}
            </strong>

            · {{ section.settings.review_count }}

          </div>

        </div>

      {% endif %}

    </div>



    <!-- CAROUSEL -->

    <div class="reviews-track">

      {% for block in section.blocks %}

        <article
          class="review-card"
          {{ block.shopify_attributes }}
        >


          <!-- IMAGE CLIENT -->

          <div class="review-image-wrap">

            {% if block.settings.image != blank %}

              <img
                class="review-image"

                src="{{ block.settings.image | image_url: width: 900 }}"

                alt="{{ block.settings.image.alt | escape }}"

                loading="lazy"

                width="{{ block.settings.image.width }}"

                height="{{ block.settings.image.height }}"
              >

            {% else %}

              <div class="review-image-placeholder">

                Ajouter une photo

              </div>

            {% endif %}

          </div>



          <!-- AVIS -->

          <div class="review-content">


            <div class="review-top">


              <div class="review-stars">

                {% for i in (1..5) %}

                  <span>★</span>

                {% endfor %}

              </div>


              {% if block.settings.verified %}

                <div class="verified">

                  <span class="verified-check">
                    ✓
                  </span>

                  <span>
                    Vérifié
                  </span>

                </div>

              {% endif %}

            </div>



            {% if block.settings.review != blank %}

              <p class="review-text">

                {{ block.settings.review }}

              </p>

            {% endif %}



            <div class="review-bottom">


              {% if block.settings.name != blank %}

                <span class="review-name">

                  {{ block.settings.name }}

                </span>

              {% endif %}


              {% if block.settings.date != blank %}

                <span class="review-date">

                  {{ block.settings.date }}

                </span>

              {% endif %}


            </div>


          </div>


        </article>

      {% endfor %}

    </div>

  </div>

</section>



{% schema %}
