{% doc %}
  @prompt
    fait une section juste avec une image full wiidd
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-full-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-full-image-{{ ai_gen_id }}__link,
  .ai-full-image-{{ ai_gen_id }}__media,
  .ai-full-image-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
  }

  .ai-full-image-{{ ai_gen_id }}__media,
  .ai-full-image-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-full-image-{{ ai_gen_id }}__media {
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-full-image-{{ ai_gen_id }}__placeholder {
    background: {{ block.settings.placeholder_background }};
    color: {{ block.settings.placeholder_text_color }};
    aspect-ratio: 16 / 6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-full-image-{{ ai_gen_id }}__placeholder svg {
    max-width: 420px;
    max-height: 280px;
    opacity: 0.5;
  }

  .ai-full-image-{{ ai_gen_id }}__empty-state {
    position: absolute;
    padding: 12px 18px;
    font-size: 14px;
    text-align: center;
  }

  .ai-full-image-{{ ai_gen_id }}__placeholder {
    position: relative;
  }
{% endstyle %}

<div class="ai-full-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image != blank %}
    {% if block.settings.image_link != blank %}
      <a href="{{ block.settings.image_link }}" class="ai-full-image-{{ ai_gen_id }}__link">
    {% endif %}

    <img
      src="{{ block.settings.image | image_url: width: 2400 }}"
      alt="{{ block.settings.image.alt | escape }}"
      class="ai-full-image-{{ ai_gen_id }}__media"
      width="{{ block.settings.image.width }}"
      height="{{ block.settings.image.height }}"
      loading="lazy"
    >

    {% if block.settings.image_link != blank %}
      </a>
    {% endif %}
  {% else %}
    <div class="ai-full-image-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-full-image-{{ ai_gen_id }}__empty-state">Ajoutez une image depuis l’éditeur de thème</div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image pleine largeur",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Lien de l’image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajustement de l’image",
      "options": [
        {
          "value": "contain",
          "label": "Afficher entièrement"
        },
        {
          "value": "cover",
          "label": "Remplir"
        }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Rayon des coins",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "placeholder_background",
      "label": "Fond de remplacement",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Texte de remplacement",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Image pleine largeur"
    }
  ],
  "tag": null,
  "class": "full-width-image-block"
}
{% endschema %}