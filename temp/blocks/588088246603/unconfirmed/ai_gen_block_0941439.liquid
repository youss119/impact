{% doc %}
  @prompt
    cree moi une section ou ya un séparateur  que je peuc modifie la couleur et je peux choisir le separateur 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-separator-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_spacing }}px 0;
  }

  .ai-separator-{{ ai_gen_id }}__line {
    width: 100%;
    height: {{ block.settings.thickness }}px;
    background: {{ block.settings.color }};
  }

  .ai-separator-{{ ai_gen_id }}__line--double {
    height: calc({{ block.settings.thickness }}px * 3);
    background: repeating-linear-gradient(to bottom, {{ block.settings.color }} 0, {{ block.settings.color }} {{ block.settings.thickness }}px, transparent {{ block.settings.thickness }}px, transparent calc({{ block.settings.thickness }}px * 2));
  }

  .ai-separator-{{ ai_gen_id }}__line--dashed {
    height: {{ block.settings.thickness }}px;
    background: repeating-linear-gradient(to right, {{ block.settings.color }} 0, {{ block.settings.color }} {{ block.settings.dash_length }}px, transparent {{ block.settings.dash_length }}px, transparent calc({{ block.settings.dash_length }}px * 2));
  }

  .ai-separator-{{ ai_gen_id }}__line--dotted {
    height: {{ block.settings.thickness }}px;
    background: radial-gradient(circle, {{ block.settings.color }} {{ block.settings.thickness }}px, transparent {{ block.settings.thickness }}px) left center / {{ block.settings.dot_spacing }}px {{ block.settings.thickness | times: 2 }}px repeat-x;
  }

  .ai-separator-{{ ai_gen_id }}__line--gradient {
    height: {{ block.settings.thickness }}px;
    background: linear-gradient(to right, transparent, {{ block.settings.color }}, transparent);
  }
{% endstyle %}

<div class="ai-separator-{{ ai_gen_id }}" {{ block.shopify_attributes }} role="separator" aria-hidden="true">
  <div class="ai-separator-{{ ai_gen_id }}__line ai-separator-{{ ai_gen_id }}__line--{{ block.settings.separator_style }}"></div>
</div>

{% schema %}
{
  "name": "Séparateur réglable",
  "settings": [
    {
      "type": "select",
      "id": "separator_style",
      "label": "Style du séparateur",
      "options": [
        { "value": "solid", "label": "Ligne simple" },
        { "value": "double", "label": "Ligne double" },
        { "value": "dashed", "label": "Tirets" },
        { "value": "dotted", "label": "Points" },
        { "value": "gradient", "label": "Dégradé" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Couleur",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Épaisseur",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Espacement vertical",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "dash_length",
      "label": "Longueur des tirets",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "dot_spacing",
      "label": "Espacement des points",
      "min": 6,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Séparateur réglable"
    }
  ],
  "tag": null,
  "class": "separateur-reglable"
}
{% endschema %}